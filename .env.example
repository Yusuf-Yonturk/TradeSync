# .env olarak kopyalayip doldurun; docker compose otomatik okur.

# Oturum token'larini imzalar. Uretmek icin: openssl rand -hex 32
AUTH_SECRET=

# Market maker botunun hesaplari icin sifre (en az 8 karakter). Bu hesaplar
# bakiye kontrolunden muaftir; bos birakilirsa herkesin bildigi varsayilan kullanilir.
MM_PASSWORD=

# Vekil sunucu arkasindaysaniz gercek istemci adresini tasiyan baslik (ornegin X-Real-IP)
CLIENT_IP_HEADER=
